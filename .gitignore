# Visual Studio / Rider / VSCode
.vs/
.idea/
.vscode/
*.sln.docstates

# Crash / debug
sysinfo.txt
*.stacktrace

# Package manager lock and cache exceptions
# Keep manifest and lock files versioned
!/[Pp]ackages/manifest.json
!/[Pp]ackages/packages-lock.json

# Addressables / bundles / generated data
/[Aa]ssets/[Aa]ssetStoreTools*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/

# Build outputs and archives
*.apk
*.aab
*.ipa
*.app
*.unitypackage

# OS files
.DS_Store
Thumbs.db
